{
  "name": "TableKit",
  "short_name": "TableKit",
  "description": "Saved views and power tools for Filament tables",
  "start_url": "/filament-tablekit/",
  "scope": "/filament-tablekit/",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "/filament-tablekit/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/filament-tablekit/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/filament-tablekit/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
